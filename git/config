[url "https://github.cnxiaobai.com/https://github.com/"]
        insteadOf = https://github.com/
[url "https://github.com/"]
	pushInsteadOf = https://github.com/
[core]
    pager = delta

[interactive]
    diffFilter = delta --color-only

[delta]
    features = catppuccin-mocha
    navigate = true              # less 里用 n / N 在文件间跳
    line-numbers = true
    hyperlinks = true
    true-color = always
    max-line-length = 1024       # 大文件/压缩产物不至于卡住
    # side-by-side = true        # 宽屏舒服，窄终端/手机 SSH 就别开

[diff]
    colorMoved = default         # 让"移动的代码块"和"真改动"区分开

[merge]
    conflictstyle = zdiff3       # git 2.35+；旧版用 diff3
